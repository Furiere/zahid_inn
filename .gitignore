# Photos are NOT in git — they are uploaded by hand into the cPanel docroot
# (public_html/<site>/images/...) to keep the server disk quota down.
# .cpanel.yml deploys with `cp -R dist/*`, which only adds and overwrites,
# never deletes, so hand-uploaded images survive every push.
public/images/
dist/images/
