# Zahid Inn — server configuration.
#
# This file is part of the build output (public/ -> dist/ -> docroot), so it
# deploys with the site. It covers the Lighthouse "Best Practices" header
# audits and keeps the dev staging host out of the search index.

# ---------------------------------------------------------------------------
# Keep the staging subdomain out of search results.
#
# dev.zahid-inn.uz serves a byte-identical copy of production. Without this it
# is fully crawlable and competes with the real site for the same queries.
# The canonical tags point at zahid-inn.uz, but canonicals are a hint, not a
# directive — X-Robots-Tag is the one Google obeys.
# ---------------------------------------------------------------------------
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host ^dev\. IS_STAGING=1
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=IS_STAGING

  # -------------------------------------------------------------------------
  # Security headers
  # -------------------------------------------------------------------------

  # The site is HTTPS-only. Deliberately WITHOUT includeSubDomains and preload:
  # both are far harder to undo, and preload in particular is close to
  # permanent. Add them once you are sure every subdomain is HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # X-XSS-Protection is deprecated and can itself introduce vulnerabilities;
  # the correct modern value is 0. The server currently sends "1; mode=block",
  # so overwrite it rather than leaving it in place.
  Header always set X-XSS-Protection "0"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Nothing on this site uses these; deny them up front.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"

  # -------------------------------------------------------------------------
  # Content-Security-Policy
  #
  # Strict: no inline scripts and no inline styles. The pages were written to
  # hold to that — the root redirect lives in /assets/*.js and the two former
  # style="" rules moved into base.css. If you add an inline <script> or a
  # style="" attribute it WILL be blocked; put it in a real file instead.
  #
  # Third parties in use:
  #   fonts.googleapis.com  stylesheet for Cormorant Garamond / Work Sans
  #   fonts.gstatic.com     the font files themselves
  #   yandex.ru             the map widget iframe on the landing/contacts pages
  # -------------------------------------------------------------------------
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://yandex.ru; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Hashed assets are immutable; HTML must revalidate so a deploy is
# picked up immediately.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpe?g|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Charset — the server currently sends "Content-Type: text/html" with no
# charset, leaving browsers to fall back to the <meta> tag.
# ---------------------------------------------------------------------------
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# Extensionless URLs (/en/rooms as well as /en/rooms.html). Canonicals point at
# the .html form, so this is a convenience, not a requirement.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
